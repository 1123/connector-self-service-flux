{
  "apiVersion": "platform.confluent.io/v1beta1",
  "kind": "Connector",
  "metadata": {
    "name": "<<CONNECTOR_NAME>>",
    "namespace": "confluent"
  },
  "spec": {
    "class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "taskMax": 1,
    "connectClusterRef": { "name": "connect" },
    "connectRest": {
      "authentication": { "type": "basic", "basic": { "secretRef": "connect-rest-client" } },
      "tls": { "secretRef": "demo-ca" }
    },
    "configs": {
      "topics": "<<TOPIC>>",
      "table.name.format": "<<TABLE>>",
      "insert.mode": "upsert",
      "pk.mode": "record_value",
      "pk.fields": "<<PK_COLUMNS>>",
      "connection.url": "jdbc:postgresql://postgres.postgres.svc.cluster.local:5432/demo",
      "connection.user": "${directory:/mnt/secrets/postgres-credentials:username}",
      "connection.password": "${directory:/mnt/secrets/postgres-credentials:password}",
      "key.converter": "org.apache.kafka.connect.storage.StringConverter",
      "value.converter": "org.apache.kafka.connect.json.JsonConverter",
      "value.converter.schemas.enable": "true",
      "consumer.override.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username=\"<<CONNECTOR_NAME>>\" password=\"${directory:/mnt/secrets/connector-kafka-credentials:<<CONNECTOR_NAME>>}\";"
    }
  }
}
